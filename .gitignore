# Node
node_modules/
npm-debug.log*

# 构建产物（esbuild 输出在仓库根目录）
main.js
*.js.map
dist/

# 测试 vault / 本地环境
.env
.env.*

# macOS
.DS_Store

# 本地工具目录（不入库）
.claude/
.orca-reports/

# Orca DAG 规划执行脚本与任务 spec（暂不入库）
/scripts/*
!/scripts/build-template.mjs

# E2E 运行产物（沙箱 vault、截图、token 等均在 /tmp，不入库）
e2e/artifacts/

# 插件运行时数据（含明文 Token）——软链调试时 Obsidian 会写在仓库根目录
data.json

# 正文 HTML 缓存（插件目录下；软链调试时同样落在仓库根目录）
cache/

# Hot Reload 插件标记（本地调试用）
.hotreload
